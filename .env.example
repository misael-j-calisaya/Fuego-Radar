# Frontend (Vite) — copy to .env.local
# Base URL of the API (CloudFront distribution, or http://localhost:3001/api for the local simulator)
VITE_API_BASE_URL=http://localhost:3001/api
# API Gateway key. It ships in the browser bundle, so it is NOT a secret:
# it only identifies the client for the usage plan (throttling/quota).
VITE_API_KEY=
# Set to "false" in production to never show simulated data when the API fails
VITE_ENABLE_DEMO_FALLBACK=true

# Local simulator (backend/src/server.ts)
PORT=3001
CORS_ORIGIN=http://localhost:5173

# CDK deploy (infrastructure/) — read at synth time
FRONTEND_ORIGIN=https://fuegoradar.ar
FROM_EMAIL=alertas@fuegoradar.ar
VERIFY_BASE_URL=https://fuegoradar.ar/
API_KEY_SSM_NAME=/fuegoradar/prod/API_KEY

# Ops scripts (scripts/ops/)
AWS_REGION=us-east-1
TABLE_NAME=FireRiskEngine
API_BASE_URL=
API_KEY=
